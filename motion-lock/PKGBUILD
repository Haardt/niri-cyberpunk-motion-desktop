pkgname=motion-lock
pkgver=0.2.0
pkgrel=1
pkgdesc='Rust Wayland locker with animated shaders and motion-login UI'
arch=('x86_64')
license=('GPL-3.0-or-later')
depends=('glibc' 'gcc-libs' 'pam' 'wayland' 'libxkbcommon' 'libglvnd' 'mesa')
makedepends=('cargo' 'clang' 'pkgconf')
optdepends=('fprintd: fingerprint unlock')
backup=('etc/pam.d/motion-lock' 'etc/pam.d/motion-lock-fingerprint')
source=('motion-lock-src.tar.gz')
sha256sums=('SKIP')

build() {
    cd "$srcdir/motion-lock"
    CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$startdir/target}" cargo build --release --locked -j "${CARGO_BUILD_JOBS:-11}"
}

check() {
    cd "$srcdir/motion-lock"
    CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$startdir/target}" cargo test --locked -j "${CARGO_BUILD_JOBS:-11}"
}

package() {
    cd "$srcdir/motion-lock"
    install -Dm755 "${CARGO_TARGET_DIR:-$startdir/target}/release/motion-lock" "$pkgdir/usr/bin/motion-lock"
    install -Dm644 packaging/motion-lock-fingerprint.pam "$pkgdir/etc/pam.d/motion-lock-fingerprint"
    install -Dm644 packaging/motion-lock.pam "$pkgdir/etc/pam.d/motion-lock"
    install -Dm644 packaging/motion-lock-preview.desktop "$pkgdir/usr/share/applications/motion-lock-preview.desktop"
    install -Dm644 config.example.toml "$pkgdir/usr/share/doc/motion-lock/config.example.toml"
    install -Dm644 README.md "$pkgdir/usr/share/doc/motion-lock/README.md"
    install -Dm644 THIRD-PARTY.txt "$pkgdir/usr/share/doc/motion-lock/THIRD-PARTY.txt"
    install -Dm644 fonts/dejavu/LICENSE "$pkgdir/usr/share/licenses/motion-lock/DejaVu.txt"
}
