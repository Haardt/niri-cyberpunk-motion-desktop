# Local source archive generated by build-package.sh.
pkgname=niri-motion-background
pkgver=0.1.0
pkgrel=1
pkgdesc='Native Wayland shader, image and video wallpapers for niri'
arch=('x86_64')
license=('MIT' 'Apache-2.0' 'LicenseRef-Shader-Assets')
depends=('glibc' 'gcc-libs' 'wayland' 'libglvnd' 'mesa')
makedepends=('rust' 'pkgconf')
optdepends=('mpv: video backgrounds' 'niri: compositor integration')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SOURCE_HASH')

build() {
    cd "$srcdir/$pkgname-$pkgver/$pkgname"
    cargo build --release --locked -j "${CARGO_BUILD_JOBS:-4}"
}

check() {
    cd "$srcdir/$pkgname-$pkgver/$pkgname"
    cargo test --locked -j "${CARGO_BUILD_JOBS:-4}"
    cargo test --locked --manifest-path ../motion-render/Cargo.toml -j "${CARGO_BUILD_JOBS:-4}"
    target/release/niri-motion-background check --config config.toml
}

package() {
    cd "$srcdir/$pkgname-$pkgver/$pkgname"
    install -Dm755 target/release/niri-motion-background "$pkgdir/usr/bin/niri-motion-background"
    install -Dm755 packaging/noctalia-wallpaper.sh "$pkgdir/usr/lib/niri-motion-background/noctalia-wallpaper.sh"
    install -Dm644 packaging/arch/niri-motion-background.service "$pkgdir/usr/lib/systemd/user/niri-motion-background.service"
    install -Dm644 config.toml "$pkgdir/usr/share/niri-motion-background/config.toml"
    install -d "$pkgdir/usr/share/niri-motion-background/shaders"
    cp -a shaders/. "$pkgdir/usr/share/niri-motion-background/shaders/"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 THIRD_PARTY.md "$pkgdir/usr/share/licenses/$pkgname/THIRD_PARTY.md"
    cp -a third_party "$pkgdir/usr/share/licenses/$pkgname/"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
